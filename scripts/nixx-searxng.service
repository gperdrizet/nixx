[Unit]
Description=SearXNG metasearch for nixx web_search
Documentation=https://github.com/searxng/searxng
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=siderealyear
WorkingDirectory=/home/siderealyear/nixx/services/searxng
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop

[Install]
WantedBy=nixx.target
